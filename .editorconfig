# Editor settings that match the files already in the repository. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for a line break.
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# The SvelteKit app (sv create defaults) is indented with tabs.
[frontend/**.{svelte,ts,js,json,css,html}]
indent_style = tab

# Windows scripts are checked out with CRLF (.gitattributes).
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Generated by scripts and notebooks: leave them exactly as they are written.
[{backend/models/**,eval/results/**,*.ipynb}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
