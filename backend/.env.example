# Copy to backend/.env and fill in. backend/.env is git-ignored.
GROQ_API_KEY=
# Optional overrides
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_ASR_MODEL=whisper-large-v3
# Use OpenAI instead (also sends the photo to GPT-4o)
OPENAI_API_KEY=
LLM_PROVIDER=
# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=
# Keep uploads in Vercel Blob (off by default)
STORE_UPLOADS=0
BLOB_READ_WRITE_TOKEN=
