{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p e2e/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^22.20.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.8",
		"typescript": "^5.0.0",
		"vite": "^7.0.4",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@fontsource/fraunces": "^5.3.0",
		"@fontsource/noto-sans": "^5.3.0",
		"@fontsource/noto-sans-devanagari": "^5.3.0",
		"@fontsource/noto-sans-gujarati": "^5.3.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^16.2.0"
	}
}
